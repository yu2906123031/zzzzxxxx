# Copy this file to .env.init-live and configure locally. Never commit credentials.
# Hyperliquid API authorization: https://app.hyperliquid.xyz/API
# Account address must be the funded main account, not the API signer address.
HL_ACCOUNT_ADDRESS=
HL_API_PRIVATE_KEY=
# Aster: https://www.asterdex.com/zh-CN/api-wallet -> Pro API
ASTER_USER_ADDRESS=
ASTER_API_PRIVATE_KEY=
